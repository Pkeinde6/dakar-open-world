; Dakar Open World - prototype Godot (rendu realiste, APK et Setup Windows hors store)

config_version=5

[application]

config/name="Dakar Open World"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=60

[rendering]

; moteur « Mobile » : leger, tourne sur une puce graphique integree (Intel UHD) et sur les telephones
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/screen_space_aa=1
; image 3D calculee a 70 % puis agrandie (FSR) : presque deux fois plus fluide sur Intel UHD
scaling_3d/mode=0
scaling_3d/scale=0.7
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/vram_compression/import_etc2_astc=true
